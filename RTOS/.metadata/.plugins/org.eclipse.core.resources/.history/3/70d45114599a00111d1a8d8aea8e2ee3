/* USER CODE BEGIN 4 */
void SensorTask(void *argument)
{
    uint8_t raw[6];
    uint8_t wake = 0;
    uint8_t overThresholdCount = 0;
    AccidentStatus_t msg;

    HAL_I2C_Mem_Write(&hi2c1, 0x68 << 1, 0x6B,
                       I2C_MEMADD_SIZE_8BIT, &wake, 1, 100);

    for (;;)
    {
        if (HAL_I2C_Mem_Read(&hi2c1, 0x68 << 1, 0x3B,
                              I2C_MEMADD_SIZE_8BIT, raw, 6, 100) == HAL_OK)
        {
            int16_t ax = (int16_t)((raw[0] << 8) | raw[1]);
            int16_t ay = (int16_t)((raw[2] << 8) | raw[3]);
            int16_t az = (int16_t)((raw[4] << 8) | raw[5]);

            uint8_t overThreshold =
                (abs(ax) > ACCEL_THRESHOLD ||
                 abs(ay) > ACCEL_THRESHOLD ||
                 abs(az) > ACCEL_THRESHOLD) ? 1 : 0;

            overThresholdCount = overThreshold ? (overThresholdCount + 1) : 0;

            if (overThresholdCount >= ACCEL_DEBOUNCE_COUNT)
            {
                overThresholdCount = 0;
                msg.accident = 1;

                TxData[0] = 1;
                HAL_CAN_AddTxMessage(&hcan1, &TxHeader, TxData, &TxMailbox);

                xQueueSend(alertQueueHandle, &msg, 0);
            }
        }
        vTaskDelay(pdMS_TO_TICKS(50));
    }
}

/* =====================================================================
 * CAN Rx callback (ISR context)
 * =====================================================================
 */
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{
    AccidentStatus_t msg;
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK)
    {
        msg.accident = RxData[0] ? 1 : 0;
        if (msg.accident)
        {
            xQueueSendFromISR(alertQueueHandle, &msg, &xHigherPriorityTaskWoken);
        }
    }

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

/* =====================================================================
 * AlertTask - single consumer of the fused alert queue. Updates the LCD
 * and fans the event out to BOTH the GSM task (SMS) and the telemetry
 * task (HTTP POST to Flask).
 * =====================================================================
 */
void AlertTask(void *argument)
{
    AccidentStatus_t msg;
    DashboardEvent_t dash;

    for (;;)
    {
        if (xQueueReceive(alertQueueHandle, &msg, portMAX_DELAY) == pdPASS)
        {
            lcd_clear();
            lcd_puts(LCD_LINE2, msg.accident ? "ACCIDENT" : "SAFE");

            if (msg.accident)
            {
                xQueueSend(gsmQueueHandle, &msg, 0);

                dash.accident = msg.accident;
                xQueueSend(uiQueueHandle, &dash, 0);
            }
        }
    }
}

/* =====================================================================
 * GPSTask
 * =====================================================================
 */
void GPSTask(void *argument)
{
    GpsData_t parsed;

    for (;;)
    {
        if (gps_sentence_ready)
        {
            taskENTER_CRITICAL();
            strncpy(gps_sentence_copy, gps_buffer, sizeof(gps_sentence_copy) - 1);
            gps_sentence_copy[sizeof(gps_sentence_copy) - 1] = '\0';
            gps_sentence_ready = 0;
            taskEXIT_CRITICAL();

            if (strncmp(gps_sentence_copy, "$GPGGA", 6) == 0)
            {
                if (GPS_ParseGGA(gps_sentence_copy, &parsed))
                {
                    xSemaphoreTake(gpsMutexHandle, portMAX_DELAY);
                    gpsData = parsed;
                    xSemaphoreGive(gpsMutexHandle);
                }
            }
        }
        vTaskDelay(pdMS_TO_TICKS(100));
    }
}

static uint8_t GPS_ParseGGA(const char *sentence, GpsData_t *out)
{
    char copy[160];
    strncpy(copy, sentence, sizeof(copy) - 1);
    copy[sizeof(copy) - 1] = '\0';

    char *field[7] = {0};
    char *tok = strtok(copy, ",");
    for (int i = 0; i < 7 && tok != NULL; i++)
    {
        field[i] = tok;
        tok = strtok(NULL, ",");
    }
    if (!field[2] || !field[3] || !field[4] || !field[5] || !field[6])
        return 0;
    if (field[6][0] == '0')
        return 0;

    out->latitude  = GPS_ToDecimalDegrees(field[2], field[3][0]);
    out->longitude = GPS_ToDecimalDegrees(field[4], field[5][0]);
    out->valid = 1;
    return 1;
}

static float GPS_ToDecimalDegrees(const char *raw, char hemisphere)
{
    float value = atof(raw);
    int degrees = (int)(value / 100);
    float minutes = value - (degrees * 100);
    float decimal = degrees + (minutes / 60.0f);

    if (hemisphere == 'S' || hemisphere == 'W')
        decimal = -decimal;

    return decimal;
}

/* =====================================================================
 * GSMTask - sends the SMS, including GPS coordinates if we have a fix.
 * =====================================================================
 */
void GSMTask(void *argument)
{
    AccidentStatus_t msg;
    char text[140];
    GpsData_t gpsSnapshot;

    for (;;)
    {
        if (xQueueReceive(gsmQueueHandle, &msg, portMAX_DELAY) == pdPASS)
        {
            if (msg.accident)
            {
                xSemaphoreTake(gpsMutexHandle, portMAX_DELAY);
                gpsSnapshot = gpsData;
                xSemaphoreGive(gpsMutexHandle);

                if (gpsSnapshot.valid)
                {
                    snprintf(text, sizeof(text),
                             "ACCIDENT DETECTED! Location: https://maps.google.com/?q=%.6f,%.6f",
                             gpsSnapshot.latitude, gpsSnapshot.longitude);
                }
                else
                {
                    snprintf(text, sizeof(text),
                             "ACCIDENT DETECTED! GPS fix not available yet.");
                }

                GSM_SendSMS(GSM_ALERT_NUMBER, text);
                vTaskDelay(pdMS_TO_TICKS(GSM_RETRY_COOLDOWN_MS));
            }
        }
    }
}

/* =====================================================================
 * TelemetryTask - consumes uiQueueHandle and POSTs a JSON payload to
 * your Flask app (app.py -> /api/telemetry -> db.py) over the GSM
 * module's GPRS/HTTP AT stack. Also keeps a local LCD readout as a
 * cheap backup display since the LCD is otherwise idle.
 *
 * NOTE: GSM_HTTPPost() shares huart2 with GSM_SendSMS(). Both tasks
 * touch the same UART, so if you see interleaved/corrupted AT traffic
 * under load, wrap huart2 access in its own mutex (gsmUartMutexHandle)
 * and take/give it inside GSM_SendSMS() and GSM_HTTPPost().
 * =====================================================================
 */
void TelemetryTask(void *argument)
{
    DashboardEvent_t evt;
    GpsData_t gpsSnapshot;
    char json[192];

    for (;;)
    {
        if (xQueueReceive(uiQueueHandle, &evt, portMAX_DELAY) == pdPASS)
        {
            xSemaphoreTake(gpsMutexHandle, portMAX_DELAY);
            gpsSnapshot = gpsData;
            xSemaphoreGive(gpsMutexHandle);

            if (gpsSnapshot.valid)
            {
                snprintf(json, sizeof(json),
                         "{\"accident\":%d,\"lat\":%.6f,\"lon\":%.6f,\"fix\":true}",
                         evt.accident, gpsSnapshot.latitude, gpsSnapshot.longitude);
            }
            else
            {
                snprintf(json, sizeof(json),
                         "{\"accident\":%d,\"lat\":null,\"lon\":null,\"fix\":false}",
                         evt.accident);
            }

            GSM_HTTPPost(TELEMETRY_URL, json);

            lcd_clear();
            lcd_puts(LCD_LINE1, evt.accident ? "ACCIDENT" : "SAFE");
            lcd_puts(LCD_LINE2, gpsSnapshot.valid ? "GPS OK - SENT" : "NO FIX - SENT");

            vTaskDelay(pdMS_TO_TICKS(TELEMETRY_RETRY_COOLDOWN_MS));
        }
    }
}

/* =====================================================================
 * GPS UART Rx interrupt
 * =====================================================================
 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        if (gps_rx == '\r')
        {
            /* ignore CR, wait for LF to terminate the sentence */
        }
        else if (gps_rx == '\n')
        {
            gps_buffer[gps_index] = '\0';
            gps_index = 0;
            gps_sentence_ready = 1;
        }
        else if (gps_index < sizeof(gps_buffer) - 1)
        {
            gps_buffer[gps_index++] = gps_rx;
        }
        else
        {
            gps_index = 0;
        }

        HAL_UART_Receive_IT(&huart1, &gps_rx, 1);
    }
}

